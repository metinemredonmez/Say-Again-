# Kopyala: cp .env.example .env
PORT=3000

# Senaryo klasoru. Bos birakirsan depodaki content/ klasoru kullanilir.
# CONTENT_DIR=

# Yerel PostgreSQL (kok klasorde: docker compose up -d db). Asama 2'de kullanilacak.
DATABASE_URL=postgres://sayagain:sayagain@localhost:5432/say_again

# AI saglayicilari. Anahtarlar yalnizca burada durur, mobil uygulamaya asla konmaz.
# Asama 1'de secilecek; o zamana kadar sahte (mock) saglayicilarla calis.
AI_PROVIDER=mock
STT_API_KEY=
LLM_API_KEY=
TTS_API_KEY=
