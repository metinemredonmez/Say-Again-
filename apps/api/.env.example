# Kopyala: cp .env.example .env   (gizli anahtarlar yalnizca .env icinde durur; .env git'e girmez)
# Butun ayarlar acilista dogrulanir (src/config/env.ts); eksik ya da hatali deger API'yi baslatmaz.

NODE_ENV=development
PORT=3000
# Bir ters vekilin (proxy) arkasindaysan yalnizca onu yaz: loopback, 1 (atlama sayisi) ya da adresler.
# TRUST_PROXY=

# Veritabani. PostgreSQL olmadan yerel calisma icin: pglite:./.data/pglite (ya da pglite:memory).
# Yerel PostgreSQL (Homebrew): createdb say_again, sonra:
# DATABASE_URL=postgres://localhost:5432/say_again
DATABASE_URL=pglite:./.data/pglite
# Gelistirmede gocler acilista uygulanir. Uretimde varsayilan kapali: npm run db:migrate ile uygula.
# DATABASE_MIGRATE=true

# Erisim tokenlarini imzalayan sir, en az 32 bayt. Uret: openssl rand -base64 32
JWT_SECRET=

# mock: sahte saglayicilar (anahtar ve maliyet yok). live: Claude (koc, degerlendirici) ve OpenAI (ses).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# COACH_MODEL=claude-haiku-5-5
# EVALUATOR_MODEL=claude-opus-5-5
# STT_MODEL=gpt-transcribe
# DIKKAT: OpenAI'nin /v1/audio/speech modelleri 2027-01-06'da kapaniyor (docs/KARARLAR.md).
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=marin

# Kota: uc ucretsiz ders, abonelikle ayda 20. Gunluk sinirlar gercek AI harcamasina gore islenir.
# FREE_LESSONS=3
# MONTHLY_LESSONS=20
# DAILY_LESSON_STARTS=10
# DAILY_USER_AI_BUDGET_USD=1.5       # kullanici basina gunluk AI harcamasi (USD)
# GLOBAL_DAILY_AI_BUDGET_USD=100      # herkes icin toplam gunluk AI harcamasi (USD)
# Pilot icin abonelik kontrolunu kapat (gunluk sinirlar kalir):
# PAYWALL_ENABLED=false

# Magaza abonelikleri (dogrudan Apple ve Google ile dogrulanir). Virgulle ayrilmis urun kimlikleri:
SUBSCRIPTION_PRODUCT_IDS=say_again_monthly

# Apple (App Store Connect > Users and Access > Integrations > In-App Purchase anahtari)
# APPLE_BUNDLE_ID=
# APPLE_APP_APPLE_ID=          # uygulamanin sayisal Apple ID'si; Production icin zorunlu
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=           # .p8 dosyasinin icerigi; satir sonlari \n olarak yazilabilir
# APPLE_ENVIRONMENT=Sandbox    # Sandbox ya da Production
# APPLE_ROOT_CERTS_DIR=        # Apple kok sertifikalarinin (.cer) klasoru: README'ye bak

# Google Play (Play Console > API erisimi > servis hesabi; RTDN icin Pub/Sub push aboneligi)
# GOOGLE_PACKAGE_NAME=
# GOOGLE_SERVICE_ACCOUNT_JSON= # servis hesabi JSON'u tek satirda
# GOOGLE_PUBSUB_AUDIENCE=      # push aboneliginde verilen audience
# GOOGLE_PUBSUB_SERVICE_ACCOUNT= # push aboneliginin OIDC servis hesabi e-postasi
